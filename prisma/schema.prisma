generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workflow {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Untitled Workflow")
  graph     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      WorkflowRun[]

  @@index([userId])
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     RunStatus @default(PENDING)
  scope      RunScope  @default(FULL)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  nodeRuns   NodeRun[]

  @@index([workflowId])
}

model NodeRun {
  id            String        @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  nodeId        String
  nodeType      String
  nodeLabel     String?
  status        RunStatus     @default(PENDING)
  inputs        Json?
  output        Json?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?

  @@index([workflowRunId])
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum RunScope {
  FULL
  PARTIAL
  SINGLE
}
